<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The iOS app icon's bars (assets/brand/appicon-dark.svg in getdictus/dictus-ios, 80 x 80
         units). A launcher shows the middle 72 dp of the 108 dp layers, so that square is the iOS
         tile: x' = 18 + 0.9 x, y' = 18 + 0.9 y. Bars 9 wide, 18 / 42 / 27 tall, 7.5 apart, with
         round ends; the drawing (42 x 42 units, 37.8 dp) stays well inside the 66 dp safe zone. -->

    <!-- Bar 1 (short left): x 19, y 31, 9 x 18 -->
    <path
        android:pathData="M35.1,49.95 A4.05,4.05 0 0,1 43.2,49.95 L43.2,58.05 A4.05,4.05 0 0,1 35.1,58.05 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45"/>

    <!-- Bar 2 (tall center): x 35.5, y 19, 9 x 42 -->
    <path
        android:pathData="M49.95,39.15 A4.05,4.05 0 0,1 58.05,39.15 L58.05,68.85 A4.05,4.05 0 0,1 49.95,68.85 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="49.95"
                android:startY="35.1"
                android:endX="58.05"
                android:endY="72.9">
                <item android:offset="0.0" android:color="#FF6BA3FF"/>
                <item android:offset="1.0" android:color="#FF2563EB"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar 3 (medium right): x 52, y 26, 9 x 27 -->
    <path
        android:pathData="M64.8,45.45 A4.05,4.05 0 0,1 72.9,45.45 L72.9,61.65 A4.05,4.05 0 0,1 64.8,61.65 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.65"/>

</vector>
