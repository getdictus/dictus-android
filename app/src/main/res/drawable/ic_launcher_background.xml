<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- iOS tile gradient (assets/brand/appicon-dark.svg in getdictus/dictus-ios), top-left to
         bottom-right corner of the 72 dp a launcher shows, so the visible tile matches iOS. -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0.0" android:color="#FF0D2040"/>
                <item android:offset="1.0" android:color="#FF071020"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
